{
  "name": "multi-browser",
  "version": "0.1.0",
  "description": "Desktop multi-account isolated browser manager.",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "antd": "^5.15.4",
    "fs-extra": "^11.2.0",
    "playwright": "^1.42.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
